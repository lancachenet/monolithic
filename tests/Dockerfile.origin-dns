# Fixture only. The production Dockerfile retains the upstream base image.
FROM nginx:1.30.6@sha256:a7675fcee220f59b4a99f7098c06a0d5d999c2c0ee37c0211efb780536e5cb20
RUN apt-get update && apt-get install -y --no-install-recommends python3 openssl && rm -rf /var/lib/apt/lists/*
COPY overlay/ /
COPY overlay/ /src/overlay/
COPY tests/integration_origin_dns.py /src/tests/integration_origin_dns.py
ENTRYPOINT ["python3"]
CMD ["/src/tests/integration_origin_dns.py"]
